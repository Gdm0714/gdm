{
  "name": "gdm",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "python3 ../script/qa/rust-parity.py",
    "typecheck": "bunx --bun tsc --noEmit",
    "build": "cargo build --manifest-path ../Cargo.toml --locked --release",
    "smoke": "../target/release/gdm --version",
    "verify": "cargo test --manifest-path ../Cargo.toml --locked && bun run test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  }
}
