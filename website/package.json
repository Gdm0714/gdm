{
  "name": "gidem-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "tsc --noEmit",
    "test:e2e": "playwright test tests/e2e.spec.ts",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "check:content": "bun tests/content-check.ts",
    "test": "bun run check:content && bun run test:e2e && bun run test:a11y"
  },
  "dependencies": { "@vitejs/plugin-react": "latest", "vite": "latest", "typescript": "latest", "react": "latest", "react-dom": "latest" },
  "devDependencies": { "@playwright/test": "latest", "@axe-core/playwright": "latest", "@types/react": "latest", "@types/react-dom": "latest", "@types/node": "latest" }
}
